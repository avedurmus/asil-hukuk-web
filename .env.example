# ——— Sohbet asistanı (Asil Asistan) ———
# Zorunlu: Anthropic API anahtarı (https://platform.claude.com → API Keys)
ANTHROPIC_API_KEY=

# İsteğe bağlı: model ve düşünme düzeyi (varsayılan: claude-opus-5-5, low)
# CHATBOT_MODEL=claude-opus-5-5
# CHATBOT_EFFORT=low

# İsteğe bağlı: randevu bildirimlerinin gideceği Formspree formu (varsayılan: sitedeki iletişim formu)
# FORMSPREE_FORM_ID=mblnkeke

# İsteğe bağlı: Google Takvim – Apps Script köprüsü (önerilen; bkz. docs/google-apps-script/Code.gs)
# APPS_SCRIPT_URL=https://script.google.com/macros/s/.../exec
# APPS_SCRIPT_SECRET=

# İsteğe bağlı: Google Takvim – hizmet hesabı (alternatif; üçü birlikte tanımlanmalı)
# Tanımlanırsa asistan avukatın takvimindeki dolu saatleri göstermez ve randevuyu takvime yazar.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=randevu-asistani@proje-adi.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_ID=av.edurmus@gmail.com
# Doluluğu ayrıca dikkate alınacak takvimler (virgülle ayrılmış, isteğe bağlı)
# GOOGLE_BUSY_CALENDAR_IDS=h5mj2f0q93c5fnhk6j5icctogg@group.calendar.google.com

# ——— WhatsApp asistanı (bkz. docs/whatsapp-asistani.md) ———
# Tanımlanmadıkça asistan WhatsApp'ta hiç yanıt vermez
# WHATSAPP_BOT_ENABLED=true
# Meta System User anahtarı veya iş ortağının (BSP) API anahtarı
# WHATSAPP_ACCESS_TOKEN=
# Yalnızca Meta'ya doğrudan bağlantıda: telefon numarası kimliği ve App Secret (webhook imzası)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# Webhook doğrulama anahtarı (kendiniz belirleyin, uzun ve rastgele)
# WHATSAPP_VERIFY_TOKEN=
# İş ortağı üzerinden bağlantıda
# WHATSAPP_PROVIDER=360dialog
# Test modu: yalnızca bu numaralara yanıt verilir (virgülle ayrılmış)
# WHATSAPP_ALLOWED_NUMBERS=0532 000 00 00
# Asla yanıt verilmeyecek kişisel numaralar (virgülle ayrılmış)
# WHATSAPP_PERSONAL_NUMBERS=
# Devirden / telefondan yazmanızdan sonra asistanın susacağı süre (saat)
# WHATSAPP_HUMAN_HOURS=72
# Sohbet geçmişi için Upstash Redis (Vercel → Storage → Upstash Redis ile otomatik tanımlanır)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
